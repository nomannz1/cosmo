# Required: workspace API key, server-side only. Never ship to the browser.
# Prefer a provisioning key scoped to user_tokens:mint.
COSMO_API_KEY=cosmo_...

# Required: callers of POST /token must send `Authorization: Bearer <MINT_SECRET>`.
MINT_SECRET=dev-secret-change-me

# Optional
# EXTERNAL_USER_ID=demo-user
# COSMO_BASE_URL=https://platform.askcosmo.ai
# PORT=8787
